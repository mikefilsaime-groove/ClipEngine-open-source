# =============================================================================
# ClipEngine — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is gitignored.
#
# Both keys are also configurable inside the app at Settings → API Keys.
# These .env values are only used as a seed on first launch.
# =============================================================================

# Google Gemini — AI clip/short analysis
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy...

# HuggingFace — speaker diarization (pyannote)
# Get token: https://huggingface.co/settings/tokens
# You must also accept model terms at:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=hf_...
