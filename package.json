{
  "name": "clipengine",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron": "ELECTRON_RUN_AS_NODE= electron .",
    "electron:dev": "ELECTRON_RUN_AS_NODE= electron .",
    "electron:build": "ELECTRON_RUN_AS_NODE= next build && ELECTRON_RUN_AS_NODE= electron-builder",
    "electron:pack": "ELECTRON_RUN_AS_NODE= next build && ELECTRON_RUN_AS_NODE= electron-builder --dir"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.10",
    "@ai-sdk/openai": "^3.0.12",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "@libsql/client": "^0.17.2",
    "@mendable/firecrawl-js": "^4.11.1",
    "@prisma/adapter-libsql": "^7.7.0",
    "@prisma/client": "^7.2.0",
    "@tanstack/react-query": "^5.90.19",
    "@tiptap/pm": "^3.15.3",
    "@tiptap/react": "^3.15.3",
    "@tiptap/starter-kit": "^3.15.3",
    "@types/canvas-confetti": "^1.9.0",
    "ai": "^6.0.41",
    "apify-client": "^2.21.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^0.562.0",
    "next": "16.3.6",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "openai": "^6.16.0",
    "pexels": "^1.4.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "tailwind-merge": "^3.4.0",
    "whisper-node": "^1.1.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "^7.2.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.clipengine.app",
    "productName": "ClipEngine",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "public/**/*",
      "next.config.ts",
      "package.json",
      "prisma/schema.prisma",
      "src/generated/**/*",
      "python/**/*",
      "!python/__pycache__/**/*",
      "node_modules/**/*"
    ],
    "asar": false,
    "icon": "electron/icon.png",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "mac": {
      "icon": "electron/icon.icns",
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
